NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://schedule:schedule@localhost:5432/personal_schedule?schema=public

# 32 random bytes, encoded as base64. Never commit the real value.
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
DEMO_ENABLED=true
WORKER_ENABLED=false
TRUST_PROXY_HOPS=0

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback
MICROSOFT_ALLOWED_EMAIL_DOMAINS=ued.udn.vn

# Optional JSON override if the verified read-only UED form changes.
UED_ADAPTER_JSON=
